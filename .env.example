# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/irxcruit

# Alternative PostgreSQL configuration using individual components
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=irxcruit
# DB_USER=username
# DB_PASSWORD=password

# JWT Authentication
JWT_SECRET_KEY=secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin User (for initial setup)
ADMIN_EMAIL=admin@irxcruit.com
ADMIN_PASSWORD=change-this-password-in-production
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Email Configuration (Resend)
RESEND_API_KEY=resend-api-key
 FROM_EMAIL=no-reply@irxcruit.com
 FROM_NAME=iRxcruit Team

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_SUCCESS_URL=https://your-domain.com/payment/success
STRIPE_CANCEL_URL=https://your-domain.com/payment/cancel

# AWS S3 Storage
# AWS_ACCESS_KEY=your-aws-access-key
# AWS_SECRET_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket-name

# Google OAuth
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Application Settings
APP_NAME=iRxcruit
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# TEMPLATES_DIR=path/to/custom/templates

# Redis (for rate limiting and caching)
# REDIS_URL=redis://localhost:6379