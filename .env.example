# ─────────────────────────────────────────────────────────────────────────────
# Climbr Backend — Environment Variables
# Copy this file to .env and fill in every value before running the app.
#
#   cp .env.example .env
#
# [REQUIRED]         → app crashes on startup if missing
# [REQUIRED IN PROD] → only enforced when ENVIRONMENT=production
# ─────────────────────────────────────────────────────────────────────────────


# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | staging | production
# In production all [REQUIRED IN PROD] vars below are enforced at startup.
ENVIRONMENT=development


# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED]
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
#
# Local dev (matches docker-compose.yml defaults):
#   DATABASE_URL=postgresql://climbr:climbr_dev@localhost:5432/climbr
#
# Free/cheap hosted PostgreSQL options:
#   • Supabase  → https://supabase.com       free tier — Settings > Database > Connection string
#   • Neon      → https://neon.tech          free tier — copy connection string from dashboard
#   • Railway   → https://railway.app        add PostgreSQL plugin → Variables tab
#   • Render    → https://render.com         create PostgreSQL service → External Database URL
DATABASE_URL=postgresql://climbr:climbr_dev@localhost:5432/climbr


# ── JWT ───────────────────────────────────────────────────────────────────────
# [REQUIRED] Must be at least 32 characters. Must not be a known-weak value.
# Generate a secure key right now:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_ME_run_python_-c_import_secrets_print_secrets.token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slashes, no wildcards in prod).
# Add your Flutter web build URL and any other frontends here.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000


# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# [REQUIRED IN PROD] Seeds the initial admin account on first run.
ADMIN_EMAIL=admin@climbr.com
ADMIN_PASSWORD=REPLACE_ME_strong_password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User


# ── Email — Resend ────────────────────────────────────────────────────────────
# [REQUIRED IN PROD]
# Resend handles verification emails, password resets, and contact notifications.
# Free tier: 3 000 emails/month.
#
# How to get your key:
#   1. Sign up at https://resend.com
#   2. API Keys → Create API Key → copy (shown only once, starts with re_)
#   3. Domains → Add Domain → verify your DNS records
#      (for dev you can send from onboarding@resend.dev without a custom domain)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FROM_EMAIL=no-reply@climbr.com
FROM_NAME=Climbr Team
# [REQUIRED IN PROD] Where contact-form submissions are forwarded.
ADMIN_EMAIL=your@email.com


# ── Cloudflare R2 (File Storage) ──────────────────────────────────────────────
# [REQUIRED IN PROD]
# Stores profile images, resumes, job images, and certificates.
# R2 has zero egress fees. Free tier: 10 GB storage + 1 M Class-A ops/month.
#
# How to set up:
#   1. Log in at https://dash.cloudflare.com
#   2. Sidebar → R2 Object Storage → Create bucket
#      Name: e.g. climbr-media  |  Region: Automatic
#   3. Inside the bucket → Settings → Public access
#      → Enable R2.dev subdomain (or connect a custom domain)
#      Copy the Public Bucket URL → R2_PUBLIC_URL
#   4. Back on the R2 overview page → Manage R2 API Tokens → Create API Token
#      Permissions: Object Read & Write | Scope: your bucket
#      Copy Access Key ID      → R2_ACCESS_KEY_ID
#      Copy Secret Access Key  → R2_SECRET_ACCESS_KEY
#   5. Your Account ID is in the right-hand sidebar on any Cloudflare dashboard page
#      → R2_ACCOUNT_ID
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=climbr-media
# Public URL of the bucket, e.g. https://pub-xxxxxxxxxxxxxxxx.r2.dev
# or a custom domain: https://media.climbr.com
R2_PUBLIC_URL=https://pub-REPLACE_ME.r2.dev


# ── Paystack (Payments — NGN) ─────────────────────────────────────────────────
# [REQUIRED IN PROD]
# Employers and trainers pay Naira credits to post jobs/trainings.
# Test mode (sk_test_) works without KYC — use it in development.
#
# How to get your keys:
#   1. Sign up at https://paystack.com (free, no monthly fee)
#   2. For live mode complete KYC: Dashboard → Settings → Business Information
#      (requires BVN/NIN + CAC documents for a registered business)
#   3. Dashboard → Settings → API Keys & Webhooks
#      Copy Secret Key  → PAYSTACK_SECRET_KEY   (sk_test_... or sk_live_...)
#      Copy Public Key  → PAYSTACK_PUBLIC_KEY   (pk_test_... or pk_live_...)
#   4. In the same Webhooks section set your webhook URL:
#         https://your-api-domain.com/payments/webhook/paystack
#      PAYSTACK_WEBHOOK_SECRET = your PAYSTACK_SECRET_KEY
#      (Paystack signs webhooks with your secret key via HMAC-SHA512)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME
PAYSTACK_WEBHOOK_SECRET=sk_test_REPLACE_ME


# ── Firebase (Google Sign-in) ─────────────────────────────────────────────────
# [REQUIRED IN PROD]
# Verifies Firebase ID tokens from the Flutter app's Google sign-in flow.
#
# How to set up:
#   1. Go to https://console.firebase.google.com → Add project (or open existing)
#   2. Authentication → Sign-in method → Google → Enable → Save
#   3. Project Settings (gear icon) → Service accounts tab
#      → Generate new private key → Download the JSON file
#   4. Open the JSON file, copy all its contents onto a single line
#      and paste it as the value of FIREBASE_CREDENTIALS_JSON below.
#      The value must start with: {"type":"service_account", ...}
#   5. Copy your Project ID from the top of Project Settings → FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"REPLACE","private_key_id":"REPLACE","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n","client_email":"REPLACE@REPLACE.iam.gserviceaccount.com","client_id":"REPLACE","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"REPLACE"}


# ── App URLs ──────────────────────────────────────────────────────────────────
# APP_URL is embedded in email links (verification, password reset, etc.)
# FRONTEND_URL is your web/mobile frontend — also added to CORS_ORIGINS.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
