# ── Environment ──────────────────────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development

# ── Database (PostgreSQL required) ───────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/climbr

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. No wildcards allowed in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Admin bootstrap ──────────────────────────────────────────────────────────
# Required in all environments. No default is provided.
ADMIN_EMAIL=admin@climbr.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Required in production. Get your key at https://resend.com
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=no-reply@climbr.com
FROM_NAME=Climbr Team

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
# Required in production.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=climbr-uploads
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ── Paystack ──────────────────────────────────────────────────────────────────
# Required in production. Get your keys at https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── Firebase (Google sign-in) ─────────────────────────────────────────────────
# Required in production.
# FIREBASE_CREDENTIALS_JSON can be a file path or the raw JSON content.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_JSON=/path/to/firebase-service-account.json

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
